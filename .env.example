# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase project (Project Settings > API). With these unset, the app runs on
# browser storage and the built-in demo accounts instead of the database.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: switches on the AI trip planner. Read only by the server function
# in api/plan-trip.ts, so it never reaches a visitor's browser. Do NOT give it
# a VITE_ prefix. Without it, plans are assembled from the catalogue instead.
GEMINI_API_KEY=
# Optional: which Gemini model to use (default: gemini-flash-latest), and the
# one tried when it is busy (default: gemini-flash-lite-latest).
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Public contact address shown in the footer and on the privacy, terms and
# cookie pages (privacy requests, corrections, legal notices).
VITE_CONTACT_EMAIL=

# Optional: trip planner limits. Per account per hour and per day (defaults 15
# and 40), and AI-written plans per day across the whole site (default 1000).
# Past the site-wide limit, plans are built from the catalogue without the AI,
# so the planner keeps working without extra AI cost. Also set a budget alert
# and quota on the Gemini API key in Google Cloud: that is the hard cap.
PLANNER_HOURLY_LIMIT=
PLANNER_DAILY_LIMIT=
PLANNER_AI_DAILY_LIMIT=
