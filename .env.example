# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase project (Project Settings > API). With these unset, the app runs on
# browser storage and the built-in demo accounts instead of the database.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional. Anything prefixed VITE_ is shipped to every visitor's browser, so a
# key set here is public. Leave it empty on a deployed site; the planner then
# uses its built-in itinerary template.
VITE_GEMINI_API_KEY=
